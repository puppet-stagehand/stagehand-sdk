# Single pin file for the real-tool harness (D-07, D-11). KEY=VALUE, shell-sourceable.
# run.sh sources this; harness/fixtures_test.go parses it to check that every
# committed fixture was recorded against the pinned tool version.
#
# Changing a pin means re-recording the matching fixtures (HARNESS_RECORD=1).

# Base image, pinned by index digest (T-13-24). The tag alone moves.
RUBY_IMAGE=ruby:3.2-bookworm@sha256:bf13a46a498fb4055d0e52495c351a2648c8bc8d41b473ee3f734041a74c7f56

R10K_VERSION=5.0.3
BOLT_VERSION=4.0.0
G10K_VERSION=0.10.0
HTTP_REQUEST_VERSION=0.3.1

# g10k release tarball checksums, checked with sha256sum -c at image build.
# Source: github.com/voxpupuli/g10k/releases/tag/v0.10.0
G10K_SHA256_LINUX_AMD64=a1817f7a4ee0d75be44ff8b1054b80ee016a72a42e8682d733c3ae8e33852f12
G10K_SHA256_LINUX_ARM64=5f752ecfebfcf6f44dea6fc42bfc27258caabc078dea271888e02217cbdb915a

RUNNER_IMAGE_NAME=stagehand-harness-runner
RUNNER_TAG=r10k5.0.3-g10k0.10.0-bolt4.0.0

# Puppet Server 9 image (D-18). Built from harness/server by harness/images.sh,
# never by compose. The packages sit behind the authenticated Puppet Core apt
# repository, so only a human with a Puppet Core login can build it.
# Base image pinned by index digest (T-13-28). The tag alone moves.
SERVER_BASE_IMAGE=ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
PUPPET_RELEASE_SERIES=puppet9
PUPPET_RELEASE_DEB=puppet9-release-noble.deb
SERVER_IMAGE_NAME=stagehand-harness-server
SERVER_TAG=puppetserver9-noble
