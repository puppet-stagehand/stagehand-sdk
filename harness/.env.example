# Copy this file to harness/.env and fill in the two values.
#
# harness/.env is gitignored. It holds values only, never credentials: no
# username, password, token or key (D-18). The harness names its images for your
# Harbor registry (host/project/image:tag) but never logs in to it or pushes to
# it. There is no default on purpose, so nothing about your registry is ever
# committed.
STAGEHAND_HARBOR_HOST=
STAGEHAND_HARBOR_PROJECT=
